# ==========================================================================
# Python
# ==========================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.venv/
venv/

# ==========================================================================
# IDE / OS
# ==========================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ==========================================================================
# Copyrighted PDFs — must not be redistributed
# ==========================================================================
docs/*.pdf
*.pdf

# ==========================================================================
# Internal-only notes (not for public repo)
# ==========================================================================
docs/PROJECT_REPORT.md

# ==========================================================================
# Scratch / unrelated code
# ==========================================================================
*.f90
play.ipynb
rae2822_o_grid.ipynb
euler_1d_hllc_muscl.f90
euler_2d_hllc_muscl.f90
sod_shock_tube.f90

# ==========================================================================
# Third-party binaries and archives
# ==========================================================================
bins/
*.zip
*.exe
*.stackdump
polar.txt

# ==========================================================================
# Case directory: run-generated artifacts (regeneratable)
# ==========================================================================

# Optimization logs and databases
case/opt_log.txt
case/opt_log_run1_baseline.txt
case/opt_summary.md
case/opt_summary_run1_baseline.md
case/opt_history.h5
case/opt_history*.png
case/verify_log.txt
case/verify_log_old.txt
case/eval*_replay.log
case/baseline_replay.log
case/primal_diagnostic.log

# ParaView / OpenMDAO / adjoint caches
case/case.foam
case/.foam
case/*.foam
case/mphys.html
case/dRdWColoring_*.bin
case/dRdWPCMat_*.bin

# OpenMDAO N2 / input reports (auto-generated per run)
case/reports/

# Stray runtime marker at case/case (some builds leave a bare 'case' file)
case/case

# Extracted design vectors for a specific run (kept in results/ backups instead)
case/eval*_shape.npy
case/eval*_aoa.npy

# Solver output directories
case/postProcessing/
case/processor*/
case/logCheckMesh.txt

# Time directories in case/ (numeric folder names other than 0)
# Keeps case/0_orig/ (the source of truth) but skips case/0/ and any 8001/, 10392/, etc.
case/[1-9]*/
case/0/

# ==========================================================================
# Case LALE directory: same rules as case/ above
# ==========================================================================

# Optimization logs and databases
case_lale/opt_log.txt
case_lale/opt_lale.log
case_lale/opt_summary.md
case_lale/opt_history.h5
case_lale/opt_history*.png
case_lale/verify_log.txt
case_lale/verify_gradients.log
case_lale/eval*_replay.log
case_lale/baseline_replay.log
case_lale/baseline_lale.log
case_lale/primal_diagnostic.log
case_lale/logCheckMesh.txt

# ParaView / OpenMDAO / adjoint caches
case_lale/case.foam
case_lale/case-lale.foam
case_lale/case_lale.foam
case_lale/case_lale.OpenFOAM
case_lale/.foam
case_lale/*.foam
case_lale/mphys.html
case_lale/dRdWColoring_*.bin
case_lale/dRdWColoring_*.bin.info
case_lale/dRdWPCMat_*.bin

# OpenMDAO N2 / input reports (auto-generated per run)
case_lale/reports/

# Extracted design vectors
case_lale/eval*_shape.npy
case_lale/eval*_aoa.npy

# Per-evaluation design-vector archive written during optimization.
# Small files, but they churn on every run. Drop this line if you want a
# particular run's shape history versioned.
case_lale/shapes/

# Per-evaluation full-state archive (deformed mesh, flow fields, FFD points).
# ~3 MB per evaluation. The run archive under results/ is the keeper.
case_lale/saved/

# Solver output directories
case_lale/postProcessing/
case_lale/processor*/
case_lale/VTK/

# FFD file is generated by ffd/generate_ffd.py
case_lale/FFD/

# Blockmesh-generated files (regen from mesh/generate_cmesh.py)
case_lale/constant/polyMesh/
case_lale/system/blockMeshDict

# Time directories: keep 0_orig/ (source of truth), skip 0/ and any numeric
case_lale/[1-9]*/
case_lale/0/

# Weird accidental file from an earlier bounding operation
case_lale/1e-16

# Stray .foam files elsewhere (created when you touch case_lale.foam from outside)
mesh/case_lale.foam

# ==========================================================================
# Results backups — keep small artifacts, skip large regeneratable data
# ==========================================================================

# Full processor decomposition (huge, regeneratable)
results/*/processor*/

# Time directories inside backups (numeric names, contain flow fields ~6 MB each)
results/*/[1-9]*/

# Reconstructed mesh files inside backups (mostly duplicates of case/constant/polyMesh)
results/*/constant/polyMesh/

# Big generated files inside backups
results/*/opt_history.h5
results/*/*.log

# --- Archives written by mdo/archive_run.py (nested layout) --------------
# The archive on disk holds EVERYTHING; these rules only decide what git
# tracks. Committed: manifest.json, MANIFEST.md, config/ and geometry/ --
# the small files that make a run reproducible and comparable. Skipped:
# large binaries that can be regenerated from those.
results/*/mesh/polyMesh/
results/*/optimization/opt_history.h5
results/*/optimization/*.log
results/*/optimization/saved/
results/*/flow/

# System configs inside backups (duplicates of case/system/)
# Commented out — small files, useful for future you to see exact config used
# results/*/system/

# ==========================================================================
# Root-level artifacts
# ==========================================================================
debug.log
bash.exe.stackdump
