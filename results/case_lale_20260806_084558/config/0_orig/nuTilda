FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Verbatim from canonical DAFoam NACA0012 incompressible tutorial.
// SA transport variable, freestream seed ~ 3*nu = 4.5e-5.
// Wall BC is fixedValue 0 regardless of wall-function status (SA does not
// use a separate wall function for the transported variable).

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 4.5e-05;

boundaryField
{
    "(wing.*)"
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    inout
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    symmetry1
    {
        type            symmetry;
    }

    symmetry2
    {
        type            symmetry;
    }
}


