FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Verbatim from canonical DAFoam NACA0012 incompressible tutorial.
// Kinematic pressure (p / rho) in DASimpleFoam. Reference value is
// arbitrary; only gradients matter.

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(wing.*)"
    {
        type            zeroGradient;
    }

    inout
    {
        type            fixedValue;
        value           $internalField;
    }

    symmetry1
    {
        type            symmetry;
    }

    symmetry2
    {
        type            symmetry;
    }
}


